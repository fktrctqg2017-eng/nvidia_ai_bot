# =====================================================================
# Этот файл НЕОБЯЗАТЕЛЕН.
# =====================================================================
# Начиная с этой версии бота, все настройки удобно задавать прямо
# в файле config.py (просто откройте его и впишите свои значения —
# токен, OWNER_IDS, ADMIN_IDS и т.д.). Это самый простой способ,
# особенно если вы запускаете бота в Termux и не хотите возиться
# с отдельным .env файлом.
#
# Файл .env нужен только в двух случаях:
#   1) вы не хотите хранить токен/секреты прямо в коде (например,
#      чтобы не закоммитить их случайно в git);
#   2) вы разворачиваете бота на сервере/в Docker и настройки удобнее
#      передавать через переменные окружения.
#
# Если переменная задана и здесь, и в config.py — значение из .env
# имеет приоритет.
#
# Чтобы использовать: скопируйте этот файл в .env и раскомментируйте
# нужные строки:
#   cp .env.example .env

# BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Владелец бота (уровень доступа 2, максимальный) — через запятую, если
# владельцев несколько. Единственный уровень, который нельзя выдать/отозвать
# через сам интерфейс бота — только здесь.
# OWNER_IDS=123456789

# Администраторы (уровень доступа 1) — необязательный начальный список,
# можно оставить пустым и назначать администраторов прямо в боте
# («👑 Админ-панель → 🛡 Управление администраторами», доступно владельцу).
# ADMIN_IDS=987654321,111111111

# DB_PATH=data/bot.db

# DEFAULT_TEMPERATURE=0.7
# DEFAULT_TOP_P=0.95
# DEFAULT_MAX_TOKENS=1024
# HISTORY_LIMIT=20
# STREAM_EDIT_INTERVAL=0.6
# REQUEST_TIMEOUT=180

# Уровень "мышления" (reasoning/thinking) модели по умолчанию.
# Допустимые значения: off | low | medium | high
# DEFAULT_REASONING_EFFORT=medium

# Настройки режима агента (Code Interpreter / анализ архивов / tool use).
# AGENT_MAX_STEPS ограничивает только число шагов ReAct-цикла ВНУТРИ одного
# сообщения (защита от зацикливания модели) — расход самого лимита запросов
# подписки (rpm/rph/rpd) при этом ровно как за одно обычное сообщение.
# AGENT_MAX_STEPS=6
# SANDBOX_TIMEOUT_SECONDS=15
# SANDBOX_MEMORY_LIMIT_MB=256
# SANDBOX_CPU_LIMIT_SECONDS=10
# AGENT_CONFIRM_CODE_EXECUTION_DEFAULT=true
# AGENT_CONFIRMATION_TIMEOUT_SECONDS=300

